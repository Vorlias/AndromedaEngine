{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Build",
            "type": "cmake",
            "request": "launch",
        },
        {
            "name": "Debug (Linux GDB)",
            "type": "cppdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/bin/VorliasEditor",
            "args": [
                "-project"
            ],
            "preLaunchTask": "Build Project using CMake",
            // "processId": "${command:pickProcess}",
            "linux": {
                "MIMode": "gdb"
            },
            "setupCommands": [
                {
                    "description": "Ignore SIGPWR",
                    "text": "handle SIGPWR nostop noprint pass"
                },
                {
                    "description": "Ignore SIGUSR1",
                    "text": "handle SIGUSR1 nostop noprint pass"
                },
                {
                    "description": "Ignore SIGUSR2",
                    "text": "handle SIGUSR2 nostop noprint pass"
                },
                {
                    "description": "Ignore SIGXCPU",
                    "text": "handle SIGXCPU nostop noprint pass"
                },
                {
                    "description": "Ignore SIG37",
                    "text": "handle SIG37 nostop noprint pass"
                },
                {
                    "description": "Ignore SIG35",
                    "text": "handle SIG35 nostop noprint pass"
                }
            ]
        }
    ]
}